# One analog output, calibrated from the unit's own calibration: Ao$(N) is AO
# channel ADDR. Neither the 621x nor the 6008 has an AO readback; PINI NO
# (default) leaves the output as the unit holds it at an IOC start, and the
# record reads 0 until written.
# P, PORT, N, ADDR; optional PINI, VAL, DRVL/DRVH/LOPR/HOPR (default -10..10 V;
# the 6008's 0..5 V)
record(ao, "$(P)Ao$(N)") {
    field(DESC, "AO$(ADDR)")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR),2)AO_VALUE")
    field(PREC, "4")
    field(EGU,  "V")
    field(DRVH, "$(DRVH=10)")
    field(DRVL, "$(DRVL=-10)")
    field(HOPR, "$(HOPR=10)")
    field(LOPR, "$(LOPR=-10)")
    field(VAL,  "$(VAL=0)")
    field(PINI, "$(PINI=NO)")
}
