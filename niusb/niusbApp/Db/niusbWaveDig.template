# The finite hardware-timed scan (measComp's WaveDig names): NumChans channels
# from FirstChan, NumPoints samples each, every Dwell s on the 20 MHz clock
# (DwellActual is the clock's). Writing 1 to WaveDigRun takes one scan; the
# record returns to Done when the arrays have arrived.
# P, PORT, MAX_POINTS
record(longout, "$(P)WaveDigNumPoints") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0)WD_NUM_POINTS")
    field(VAL,  "1000")
    field(DRVL, "1")
    field(DRVH, "$(MAX_POINTS)")
    field(PINI, "YES")
}
record(longout, "$(P)WaveDigFirstChan") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0)WD_FIRST_CHAN")
    field(VAL,  "0")
    field(DRVL, "0")
    field(DRVH, "15")
    field(PINI, "YES")
}
record(longout, "$(P)WaveDigNumChans") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0)WD_NUM_CHANS")
    field(VAL,  "1")
    field(DRVL, "1")
    field(DRVH, "16")
    field(PINI, "YES")
}
record(ao, "$(P)WaveDigDwell") {
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0)WD_DWELL")
    field(VAL,  "0.001")
    field(PREC, "7")
    field(EGU,  "s")
    field(DRVL, "4e-6")
    field(DRVH, "10")
    field(PINI, "YES")
}
record(ai, "$(P)WaveDigDwellActual") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0)WD_DWELL_ACTUAL")
    field(SCAN, "I/O Intr")
    field(PREC, "8")
    field(EGU,  "s")
}
record(mbbo, "$(P)WaveDigRange") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0)WD_RANGE")
    field(ZRST, "+-10V")
    field(ZRVL, "0")
    field(ONST, "+-5V")
    field(ONVL, "1")
    field(TWST, "+-1V")
    field(TWVL, "2")
    field(THST, "+-0.2V")
    field(THVL, "3")
    field(PINI, "YES")
}
record(mbbo, "$(P)WaveDigMode") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0)WD_MODE")
    field(ZRST, "RSE")
    field(ZRVL, "0")
    field(ONST, "NRSE")
    field(ONVL, "1")
    field(TWST, "DIFF")
    field(TWVL, "2")
    field(PINI, "YES")
}
record(bo, "$(P)WaveDigRun") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,60)WD_RUN")
    field(ZNAM, "Done")
    field(ONAM, "Acquire")
    info(asyn:READBACK, "1")
}
record(waveform, "$(P)WaveDigTimeWF") {
    field(DTYP, "asynFloat64ArrayIn")
    field(INP,  "@asyn($(PORT),0)WD_TIME")
    field(SCAN, "I/O Intr")
    field(FTVL, "DOUBLE")
    field(NELM, "$(MAX_POINTS)")
    field(EGU,  "s")
}
